# PFF local development. Copy to .env.dev (git-ignored).
# Used by docker-compose.dev.yml and by `make ms-run` (backend via go run).
PFF_ENV=development
PFF_DB_PASSWORD=pff-dev-password
# Any 32 random bytes, base64 (openssl rand -base64 32). Dev only.
PFF_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS0zMi1ieXRlcyEhISE=
PFF_AUTH_MODE=dev
PFF_BANK_PROVIDER=mock
# The mock provider offers one bank (defaults to it when PFF_BANKS is empty).
PFF_BANKS="IT:PFF Demo Bank"
PFF_PUSH_PROVIDER=log
PFF_MAIL_PROVIDER=log
PFF_TIMEZONE=Europe/Rome
PFF_REPORTING_CURRENCY=EUR
PFF_HTTP_PORT=8080
PFF_SCHEDULER_INTERVAL=1h
