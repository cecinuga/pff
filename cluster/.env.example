# PFF production configuration. Copy to .env and fill in. Never commit .env.
# Every variable is read by ms/internal/config/config.go.

# ---- general ------------------------------------------------------------------
PFF_ENV=production
# Database password used by the db container and the backend.
PFF_DB_PASSWORD=change-me-to-a-long-random-string
# 32 random bytes, base64. Encrypts bank session ids at rest and keys one-time
# codes. Generate with: openssl rand -base64 32   (losing it invalidates stored sessions)
PFF_SECRET_KEY=
# Public HTTPS origin of the web app (used for the bank redirect and push links).
PFF_PUBLIC_APP_URL=https://pff.example.com
# Domain for the optional Caddy TLS front (docker compose --profile tls up -d).
PFF_DOMAIN=pff.example.com
# Host interface/port of the nginx container (127.0.0.1 keeps it private when
# Caddy or another proxy terminates TLS on the same host).
PFF_HTTP_BIND=127.0.0.1
PFF_HTTP_PORT=8080
# "Today" and daily boundaries are computed in this time zone.
PFF_TIMEZONE=Europe/Rome
# Metrics aggregate transactions in this currency only.
PFF_REPORTING_CURRENCY=EUR

# ---- authentication (Firebase, Google sign-in) ---------------------------------
PFF_AUTH_MODE=firebase
# true = users must enrol a second factor (TOTP, SMS or e-mail) to see data.
PFF_AUTH_REQUIRE_MFA=false
PFF_FIREBASE_PROJECT_ID=
# Service account JSON (Firebase console > Project settings > Service accounts),
# placed in cluster/secrets/.
GOOGLE_APPLICATION_CREDENTIALS=/run/pff-secrets/firebase-service-account.json
# Web app config (Project settings > General > Your apps). Public values.
PFF_FIREBASE_WEB_API_KEY=
PFF_FIREBASE_AUTH_DOMAIN=
PFF_FIREBASE_APP_ID=
PFF_FIREBASE_MESSAGING_SENDER_ID=

# ---- push notifications (Firebase Cloud Messaging) -------------------------------
PFF_PUSH_PROVIDER=fcm
# Project settings > Cloud Messaging > Web Push certificates > key pair (public key).
PFF_FIREBASE_VAPID_KEY=

# ---- e-mail one-time codes (second factor) ------------------------------------------
PFF_MAIL_PROVIDER=smtp
PFF_SMTP_HOST=
PFF_SMTP_PORT=587
PFF_SMTP_USER=
PFF_SMTP_PASSWORD=
PFF_MAIL_FROM="PFF <no-reply@example.com>"

# ---- bank data (Enable Banking) -----------------------------------------------------
PFF_BANK_PROVIDER=enablebanking
# Your bank(s): comma-separated "COUNTRY:Bank name" entries, with the name
# exactly as Enable Banking lists it. Users can only connect these banks.
PFF_BANKS="IT:Intesa Sanpaolo"
# personal or business accounts.
PFF_BANK_PSU_TYPE=personal
# Banking API address.
PFF_EB_BASE_URL=https://api.enablebanking.com
# Application id (kid) from the Enable Banking Control Panel.
PFF_EB_APP_ID=
# Private key of the application (PEM), placed in cluster/secrets/.
PFF_EB_PRIVATE_KEY_FILE=/run/pff-secrets/enablebanking.pem
# Requested consent length (capped by each bank's maximum).
PFF_BANK_CONSENT_DAYS=90
# Must be registered as a redirect URL of the Enable Banking application.
# Defaults to $PFF_PUBLIC_APP_URL/connections/callback.
PFF_BANK_REDIRECT_URL=

# ---- GetOrSet cache and background jobs --------------------------------------------
# Not-yet-final days (today and the last few) are re-fetched when older than this.
PFF_SYNC_FRESH_TTL=1h
# A day is final (never re-fetched) once fetched this many days after it ended.
PFF_SYNC_SETTLEMENT_DAYS=3
# Bank fetches per account per day without the user present (PSD2: usually 4).
PFF_SYNC_BACKGROUND_DAILY_MAX=4
# History requested right after connecting a bank.
PFF_SYNC_BACKFILL_DAYS=730
# Background refresh + budget evaluation interval.
PFF_SCHEDULER_INTERVAL=6h
